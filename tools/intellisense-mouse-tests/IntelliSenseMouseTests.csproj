<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IntelliSenseMouseTests</AssemblyName>
    <RootNamespace>IntelliSenseMouseTests</RootNamespace>
    <StartupObject>IntelliSenseMouseTests.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\AxialSqlTools\IntelliSense\CompletionItem.cs" Link="CompletionItem.cs" />
    <Compile Include="..\..\AxialSqlTools\IntelliSense\WpfTreeWalk.cs" Link="WpfTreeWalk.cs" />
    <Compile Include="..\..\AxialSqlTools\IntelliSense\CompletionListWindow.xaml.cs" Link="CompletionListWindow.xaml.cs" />
    <Compile Include="..\..\AxialSqlTools\Modules\ToolWindowThemeSupport.cs" Link="ToolWindowThemeSupport.cs" />
    <Page Include="..\..\AxialSqlTools\IntelliSense\CompletionListWindow.xaml"
          Link="CompletionListWindow.xaml"
          Generator="MSBuild:Compile" />
  </ItemGroup>

  <!-- Self-contained: no NuGet restore and no main-project build required.
       NLog is shimmed in ProductionStubs/NLogStubs.cs, VS SDK in ProductionStubs/VisualStudioStubs.cs. -->

</Project>
