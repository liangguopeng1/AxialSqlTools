<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IntelliSenseMatcherTests</AssemblyName>
    <RootNamespace>IntelliSenseMatcherTests</RootNamespace>
    <StartupObject>IntelliSenseMatcherTests.Program</StartupObject>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Compiles the production matcher directly. No NuGet restore, no main-project build:
       CompletionMatcher only depends on CompletionItem. -->

  <ItemGroup>
    <Compile Include="..\..\AxialSqlTools\IntelliSense\CompletionItem.cs" Link="CompletionItem.cs" />
    <Compile Include="..\..\AxialSqlTools\IntelliSense\Completion\CompletionMatcher.cs" Link="CompletionMatcher.cs" />
  </ItemGroup>

</Project>
