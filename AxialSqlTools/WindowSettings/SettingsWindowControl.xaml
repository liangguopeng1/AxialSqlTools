<UserControl x:Class="AxialSqlTools.SettingsWindowControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d"
    Name="MyToolWindow"
    Background="{DynamicResource AxialThemeBackgroundBrush}"
    Foreground="{DynamicResource AxialThemeForegroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Geometry x:Key="SaveIconGeometry">M1,1 L11,1 L13,3 L13,13 L1,13 Z M3,2 L3,5 L9,5 L9,2 Z M4,8 L10,8 L10,12 L4,12 Z</Geometry>

            <Style x:Key="AxialSaveIconPathStyle" TargetType="Path">
                <Setter Property="Fill" Value="{DynamicResource AxialThemeAccentBrush}" />
                <Setter Property="Stretch" Value="Fill" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="AxialSettingsGridViewHeaderStyle" TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="{DynamicResource AxialThemeGridHeaderBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AxialThemeForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AxialThemeBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource AxialThemeButtonHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource AxialThemeGridSelectionBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AxialSettingsListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource AxialThemeForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AxialThemeBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                      Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      Content="{TemplateBinding Content}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AxialThemeButtonHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AxialThemeGridSelectionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AxialThemeForegroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <DockPanel Background="{DynamicResource AxialThemeBackgroundBrush}">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AxialThemeHeaderBackgroundBrush}"
                Padding="12" BorderBrush="{DynamicResource AxialThemeBorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="SettingsTitleText"
                       Text="Axial SQL Tools - Settings"
					   FontWeight="Bold"
					   FontSize="20"
					   HorizontalAlignment="Center"/>
        </Border>

        <TabControl x:Name="SettingsTabControl"
                    Margin="5"
                    Background="{DynamicResource AxialThemeBackgroundBrush}"
                    BorderBrush="{DynamicResource AxialThemeBorderBrush}"
					BorderThickness="1">

            <TabItem x:Name="TabGeneral" Header="General">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabelText"
                               Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,12,8"
                               Text="UI language"/>
                    <ComboBox x:Name="UiLanguageCombo"
                              Grid.Row="0" Grid.Column="1"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,8"/>
                    <TextBlock x:Name="LanguageHintText"
                               Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Opacity="0.85"
                               Text="Tool windows refresh immediately. Toolbar and menu text fully apply after restarting SSMS."/>
                    <Button x:Name="ButtonSaveLanguage"
                            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            Content="Save language"
                            Click="Button_SaveLanguage_Click"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabQueryTemplates" Header="Query Templates">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="WikiQueryTemplatesTextBlock"
                               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" HorizontalAlignment="left" >
					  <Run Text="Feature description in"/>
						<Hyperlink
							NavigateUri="https://github.com/liangguopeng1/AxialSqlTools/wiki/Query-Templates-and-Snippets"
							RequestNavigate="buttonWikiPage_Click">
						<Run Text="Wiki"/>
					  </Hyperlink>
                    </TextBlock>

                    <Label Grid.Row="1" Grid.Column="0"
						   Content="Templates Folder:"
						   Tag="loc:Settings_TemplatesFolder"
						   VerticalAlignment="Center"
						   Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
							 x:Name="ScriptFolder"
							 VerticalContentAlignment="Center"
							 Margin="5"/>
                    <Button Grid.Row="2" Grid.Column="1"
							Content="Select folder..."
							Tag="loc:Common_SelectFolder"
							Click="BrowseButton_Click"
							Margin="5" Width="120" HorizontalAlignment="Left"
							FontWeight="Bold"/>                   


                    <Button Grid.Row="3" Grid.Column="0"
							x:Name="button_SaveScriptFolder"							
							Click="Button_SaveScriptFolder_Click"
							Width="80" 
							Height="24"
							Margin="5"
							FontWeight="Bold"
                            HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,4,0">
                                    <Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
                                </Viewbox>
								<TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
							</StackPanel>
                    </Button>

                                     


                    <TextBlock x:Name="UsefulTsqlScriptsTextBlock"
                               Grid.Row="4" Grid.Column="1" Margin="5" HorizontalAlignment="left" >
						<Run Text="Useful TSQL scripts"/>
							<Hyperlink
								NavigateUri="https://github.com/liangguopeng1/AxialSqlTools/tree/main/query-library"
								RequestNavigate="buttonWikiPage_Click">
							<Run Text="https://github.com/liangguopeng1/AxialSqlTools/tree/main/query-library"/>
					  </Hyperlink>
                    </TextBlock>
                    
                    <Button Grid.Row="5" Grid.Column="2"
							Content="Download TSQL scripts from GitHub"
							Tag="loc:Settings_DownloadQueryLibrary"
							Click="buttonDownloadAxialScripts_Click"
							Margin="5" HorizontalAlignment="Left"
							FontWeight="Bold"/>  
                    
                </Grid>
            </TabItem>

            <TabItem x:Name="TabCodeSnippets" Header="Code Snippets">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="WikiCodeSnippetsTextBlock"
                               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" HorizontalAlignment="left" >
					  <Run Text="Feature description in"/>
					  <Hyperlink
							NavigateUri="https://github.com/liangguopeng1/AxialSqlTools/wiki/Query-Templates-and-Snippets"
							RequestNavigate="buttonWikiPage_Click">
						<Run Text="Wiki"/>
					  </Hyperlink>
                    </TextBlock>

                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
							  x:Name="UseSnippets"
							  Content="Use code snippets (SSMS restart required)"
							  Tag="loc:Settings_UseSnippets"
							  Margin="5"/>

                    <Label Grid.Row="2" Grid.Column="0"
						   Content="Snippets Location:"
						   Tag="loc:Settings_SnippetsLocation"
						   VerticalAlignment="Center"
						   Margin="5"/>
                    
                    <TextBox Grid.Row="2" Grid.Column="1"
							 x:Name="SnippetFolder"
							 Margin="5" VerticalContentAlignment="Center"/>
                    
                    <Button Grid.Row="3" Grid.Column="1"
							Content="Select folder..."
							Tag="loc:Common_SelectFolder"
							Click="SnippetsBrowseButton_Click"
							Margin="5" Width="120" HorizontalAlignment="Left"
							FontWeight="Bold"/>

                    <Label Grid.Row="4" Grid.Column="0"
                                                   Content="Replace snippets when pressing:"
                                                   Tag="loc:Settings_ReplaceSnippetsWhen"
                                                   VerticalAlignment="Center"
                                                   Margin="5"/>

                    <ComboBox Grid.Row="4" Grid.Column="1"
                                                         x:Name="SnippetReplaceMode"
                                                         SelectedValuePath="Tag"
                                                         Margin="5"
                                                         VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Enter" Tag="Enter" />
                        <ComboBoxItem Content="Shift+Enter" Tag="ShiftEnter" />
                        <ComboBoxItem Content="Tab" Tag="Tab" />
                    </ComboBox>

                    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                              x:Name="UseAsteriskExpansion"
                              Content="Replace SELECT * with column list"
                              Tag="loc:Settings_ReplaceAsterisk"
                              IsEnabled="{Binding IsChecked, ElementName=UseSnippets}"
                              Margin="5"/>

                    <Label Grid.Row="6" Grid.Column="0"
                           Content="Replace asterisk when pressing:"
                           Tag="loc:Settings_ReplaceAsteriskWhen"
                           IsEnabled="{Binding IsChecked, ElementName=UseSnippets}"
                           VerticalAlignment="Center"
                           Margin="5"/>

                    <ComboBox Grid.Row="6" Grid.Column="1"
                              x:Name="AsteriskExpansionTriggerMode"
                              IsEnabled="{Binding IsChecked, ElementName=UseSnippets}"
                              SelectedValuePath="Tag"
                              Margin="5"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Enter" Tag="Enter" />
                        <ComboBoxItem Content="Shift+Enter" Tag="ShiftEnter" />
                        <ComboBoxItem Content="Tab" Tag="Tab" />
                        <ComboBoxItem Content="Ctrl+Space" Tag="CtrlSpace" />
                    </ComboBox>

                    <Button Grid.Row="7" Grid.Column="0"
                                                        x:Name="button_SaveSnippetFolder"
                                                        Click="Button_SaveSnippetFolder_Click"
                                                        Width="80"
                                                        Height="24"
							Margin="5"
							FontWeight="Bold" 
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Viewbox Width="16" Height="16" Margin="0,0,4,0">
								<Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
							</Viewbox>
							<TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabQueryHistory" Header="Query History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- new rows for creation script and spacing -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="WikiQueryHistoryTextBlock"
                               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="10" HorizontalAlignment="left">
            <Run Text="Feature description in"/>
            <Hyperlink
                NavigateUri="https://github.com/liangguopeng1/AxialSqlTools/wiki/Query-History"
                RequestNavigate="buttonWikiPage_Click">
                <Run Text="Wiki"/>
            </Hyperlink>
                    </TextBlock>
                    <Label Grid.Row="1" Grid.Column="0"
               Content="Storage Type:"
               Tag="loc:Settings_StorageType"
               Margin="5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                 x:Name="QueryHistoryStorageType"
                 Margin="5"
                 VerticalContentAlignment="Center"
                 SelectionChanged="QueryHistoryStorageType_SelectionChanged">
                        <ComboBoxItem Content="Disabled" Tag="Disabled"/>
                        <ComboBoxItem Content="Text files (JSONL)" Tag="TextFiles"/>
                        <ComboBoxItem Content="Database table" Tag="Database"/>
                    </ComboBox>

                    <Label Grid.Row="2" Grid.Column="0"
               x:Name="Label_QueryHistoryTextFilesInfo"
               Content="Text Files:"
               Tag="loc:Settings_TextFiles"
               Margin="5"/>
                    <StackPanel Grid.Row="2" Grid.Column="1"
                                x:Name="QueryHistoryTextFilesPanel"
                                Margin="5"
                                Orientation="Horizontal">
                        <TextBlock x:Name="QueryHistoryTextFilesInfo"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                        <Button x:Name="Button_OpenQueryHistoryFolder"
                                Content="Open folder"
                                Tag="loc:Settings_OpenFolder"
                                Margin="10,0,0,0"
                                Click="Button_OpenQueryHistoryFolder_Click"
                                FontWeight="Bold" />
                    </StackPanel>

                    <Label Grid.Row="3" Grid.Column="0"
               x:Name="Label_QueryHistoryConnectionInfoTitle"
               Content="Connection Info:"
               Tag="loc:Settings_ConnectionInfo"
               Margin="5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                   x:Name="Label_QueryHistoryConnectionInfo"
                   Text="&lt; not configured &gt;"
                   VerticalAlignment="Center"
                   Margin="5"/>

                    <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                Content="Use connection from Object Explorer"
                Tag="loc:Settings_UseOeConnection"
                x:Name="button_SelectDatabaseFromObjectExplorer"
                Click="Button_SelectDatabaseFromObjectExplorer_Click"
                HorizontalAlignment="Left"
                Width="240"
                Margin="5,0,0,5"
                FontWeight="Bold"/>

                    <Label Grid.Row="5" Grid.Column="0"
               x:Name="Label_QueryHistoryTargetTableName"
               Content="Target Table Name:"
               Tag="loc:Settings_TargetTableName"
               Margin="5"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                 x:Name="QueryHistoryTableName"
                 ToolTip="Leave blank to use the default [dbo].[QueryHistory] table."
                 VerticalContentAlignment="Center"
                 Margin="5"
                 TextChanged="QueryHistoryTableName_TextChanged"/>

                    <Label Grid.Row="6" Grid.Column="1"
               x:Name="Label_QueryHistoryTargetTableHint"
               Content="Leave blank to use the default [dbo].[QueryHistory] table."
               Tag="loc:Settings_TargetTableHint"
               Margin="0,0,0,5"/>

                    <!-- New: creation script viewer -->
                    <GroupBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                  x:Name="Group_QueryHistoryCreateScript"
                  Header="Creation script (for information only)"
                  Tag="loc:Settings_CreationScript"
                  Margin="5">
                        <Grid>
                            <TextBox x:Name="QueryHistoryCreateScript"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         MinHeight="160"
                         Margin="5"/>
                        </Grid>
                    </GroupBox>

                    <Button Grid.Row="9" Grid.Column="0"
                x:Name="button_SaveQueryHistory"
                Click="Button_SaveQueryHistory_Click"
                Width="80"
                Height="24"
                Margin="5"
                FontWeight="Bold" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Viewbox Width="16" Height="16" Margin="0,0,4,0">
								<Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
							</Viewbox>
                            <TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </TabItem>


            <TabItem x:Name="TabCodeFormat" Header="Code Format">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="WikiCodeFormatTextBlock"
                               Grid.Row="0" Grid.Column="0"
                               Margin="5" HorizontalAlignment="left" >
                        <Run Text="Feature description in"/>
                        <Hyperlink
                            NavigateUri="https://github.com/liangguopeng1/AxialSqlTools/wiki/TSQL-Code-Formatting-with-Microsoft-ScriptDOM-library"
                            RequestNavigate="buttonWikiPage_Click">
                            <Run Text="Wiki"/>
                        </Hyperlink>
                    </TextBlock>

                    <!-- all checkboxes in a 3-column UniformGrid -->
                    <UniformGrid Grid.Row="1"
                             Columns="3"
                             Margin="5"
                             HorizontalAlignment="Left">
                        <CheckBox x:Name="PreserveComments" Margin="5"
                              Content="Preserve comments"
                              Tag="loc:Settings_PreserveComments"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="RemoveNewLineAfterJoin" Margin="5"
                              Content="Remove new line after JOIN"
                              Tag="loc:Settings_RemoveNewlineAfterJoin"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="AddTabAfterJoinOn" Margin="5"
                              Content="Add tab after JOIN..ON"
                              Tag="loc:Settings_TabAfterJoinOn"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="MoveCrossJoinToNewLine" Margin="5"
                              Content="Place CROSS/OUTER JOIN/APPLY on a new line"
                              Tag="loc:Settings_CrossJoinNewLine"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="FormatCaseAsMultiline" Margin="5"
                              Content="Format CASE expression as multiline"
                              Tag="loc:Settings_CaseMultiline"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="AddNewLineBetweenStatementsInBlocks" Margin="5"
                              Content="Add new line between statements in code blocks"
                              Tag="loc:Settings_NewlineBetweenStatements"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="BreakSprocParametersPerLine" Margin="5"
                              Content="Break exec sproc parameters per line"
                              Tag="loc:Settings_BreakExecParams"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="UppercaseBuiltInFunctions" Margin="5"
                              Content="Always upper-case built-in functions"
                              Tag="loc:Settings_UppercaseFunctions"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="UnindentBeginEndBlocks" Margin="5"
                              Content="Unindent Begin..End blocks"
                              Tag="loc:Settings_UnindentBeginEnd"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="BreakVariableDefinitionsPerLine" Margin="5"
                              Content="Break variable definitions per line"
                              Tag="loc:Settings_BreakVarDefs"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <CheckBox x:Name="BreakSprocDefinitionParametersPerLine" Margin="5"
                              Content="Break sproc definition parameters per line"
                              Tag="loc:Settings_BreakSprocParams"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>
                        <!-- TODO -->
                        <CheckBox x:Name="BreakSelectFieldsAfterTopAndUnindent" Margin="5" Visibility="Hidden"
                              Content="Break SELECT fields after TOP and unindent"
                              Tag="loc:Settings_BreakSelectTop"
                              Checked="formatSetting_Checked"
                              Unchecked="formatSetting_Unchecked"/>

                    </UniformGrid>

                    <Button
                        Grid.Row="9"
                        x:Name="button_SaveApplyAdditionalFormat"
                        Click="Button_SaveApplyAdditionalFormat_Click"
                        Width="80" 
                        Height="24"
                        Margin="5"
                        HorizontalAlignment="Left"
                        FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Viewbox Width="16" Height="16" Margin="0,0,4,0">
								<Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
							</Viewbox>
                            <TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Source query" Tag="loc:Settings_SourceQuery" Grid.Column="0">
                            <TextBox x:Name="SourceQueryPreview"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                        </GroupBox>

                        <GroupBox Header="Formatted query" Tag="loc:Settings_FormattedQuery" Grid.Column="1">
                            <TextBox x:Name="FormattedQueryPreview"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"/>
                        </GroupBox>
                    </Grid>

                </Grid>
            </TabItem>


            <TabItem x:Name="TabExcelExport" Header="Excel Export">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="WikiExcelExportTextBlock"
                               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
							   Margin="5" HorizontalAlignment="left" >
						<Run Text="Feature description in"/>
						<Hyperlink
							NavigateUri="https://github.com/liangguopeng1/AxialSqlTools/wiki/Export-Grid-To-Excel"
							RequestNavigate="buttonWikiPage_Click">
							<Run Text="Wiki"/>
						</Hyperlink>
                    </TextBlock>

                    <CheckBox
						Grid.Row="1" Grid.ColumnSpan="2"
						x:Name="ExcelExportIncludeSourceQuery"
						Content="Include content of attached query-window on its own sheet (hold Shift to do the opposite)"
						Tag="loc:Settings_ExcelIncludeSourceQuery"
						Margin="5"/>
                    
                    <CheckBox
						Grid.Row="2" Grid.ColumnSpan="2"
						x:Name="ExcelExportAddAutoFilter"
						Content="Add filter dropdowns to header row (AutoFilter)"
						Tag="loc:Settings_ExcelAddAutoFilter"
						Margin="5"/>

                    <CheckBox
						Grid.Row="3" Grid.ColumnSpan="2"
						x:Name="ExcelExportBoolsAsNumbers"
						Content="Export booleans as numbers (TRUE/FALSE -> 1/0)"
						Tag="loc:Settings_ExcelBoolsAsNumbers"
						Margin="5"/>

                    <Label Grid.Row="4" Grid.Column="0"
						Content="Default Directory:"
						Tag="loc:Settings_DefaultDirectory"
						Margin="5"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
						x:Name="ExcelExportDefaultDirectory"
						ToolTip="Leave blank to use the Desktop"
						VerticalContentAlignment="Center"
						Margin="5"/>

                    <Label Grid.Row="5" Grid.Column="1"					
						Content="Leave blank → Desktop"
						Tag="loc:Settings_ExcelBlankDesktop"
						Margin="0,0,0,5"/>

                    <Label Grid.Row="6" Grid.Column="0"
						Content="Default Filename:"
						Tag="loc:Settings_DefaultFilename"
						Margin="5"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
						x:Name="ExcelExportDefaultFilename"
						ToolTip="Leave blank to use DataExport_{yyyyMMdd_HHmmss}.xlsx; date-wildcards supported"
						VerticalContentAlignment="Center"
						Margin="5"/>

                    <Label Grid.Row="7" Grid.Column="1"					
						Content="Leave blank → DataExport__{yyyyMMdd__HHmmss}.xlsx; use {...} for date-wildcards"
						Tag="loc:Settings_ExcelBlankFilename"
						Margin="0,0,0,0"/>


                    <Button
						Grid.Row="9"
						x:Name="button_SaveExcelExportSettings" 
						Click="button_SaveExcelExportSettings_Click"
						Width="80" 
						Height="24"
						Margin="5"
						HorizontalAlignment="Left"
						FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,4,0">
                                <Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
                            </Viewbox>
                            <TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabGoogleSheets" Header="Google Sheets">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="GoogleSheetsAuthTextBlock" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="5">
                        <Run Text="Authorize AxialSqlTools to create Google Sheets using an OAuth client ID from "/>
                        <Hyperlink NavigateUri="https://console.cloud.google.com/apis/credentials" RequestNavigate="buttonWikiPage_Click">
                            <Run Text="Google Cloud Console" />
                        </Hyperlink>
                        <Run Text="." />
                    </TextBlock>

                    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="GoogleSheetsIncludeSourceQuery" Content="Include content of attached query-window on its own sheet (hold Shift to do the opposite)" Tag="loc:Settings_ExcelIncludeSourceQuery" Margin="5"/>
                    <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="GoogleSheetsExportBoolsAsNumbers" Content="Export booleans as numbers (TRUE/FALSE -> 1/0)" Tag="loc:Settings_ExcelBoolsAsNumbers" Margin="5"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Default Spreadsheet Title:" Tag="loc:Settings_DefaultSpreadsheetTitle" Margin="5"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="GoogleSheetsDefaultSpreadsheetName" ToolTip="Leave blank to use DataExport_{yyyyMMdd_HHmmss}" VerticalContentAlignment="Center" Margin="5"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Client ID:" Tag="loc:Settings_ClientId" Margin="5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="GoogleSheetsClientId" Margin="5"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Client Secret:" Tag="loc:Settings_ClientSecret" Margin="5"/>
                    <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="GoogleSheetsClientSecret" Margin="5"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Authorization Status:" Tag="loc:Settings_AuthorizationStatus" Margin="5"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="GoogleSheetsRefreshTokenLabel" Margin="5" />

                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5">
                        <Button x:Name="button_AuthorizeGoogleSheets" Click="button_AuthorizeGoogleSheets_Click" Width="160" Height="24" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/AxialSqlTools;component/Resources/upload.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Authorize Google Sheets" Tag="loc:Settings_SaveGoogleSheets" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="button_SaveGoogleSheetsSettings" Click="button_SaveGoogleSheetsSettings_Click" Width="80" Height="24">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<Viewbox Width="16" Height="16" Margin="0,0,4,0">
									<Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
								</Viewbox>
                                <TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabConnectionColors" Header="Connection Colors">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap"
                                   Tag="loc:Settings_ConnectionColorsDesc"
                                   Text="Color query window status bars and document tabs based on the server and/or database name. If both fields are filled, both must match. Leave a field empty to match anything."/>
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AxialThemeForegroundBrush}" Opacity="0.8" FontStyle="Italic"
                                   Tag="loc:Settings_ConnectionColorsExamples"
                                   Text="Examples: Server='PROD' matches SQL-PROD-01. Database='master' matches any connection to master. Server='PROD' + Database='Sales' matches only Sales on PROD servers. First matching rule wins."/>
                    </StackPanel>

                    <!-- Add new rule area -->
                    <GroupBox Grid.Row="1" Header="Add new rule" Tag="loc:Settings_AddNewRule" Margin="0,0,0,10" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server name contains:"
                                       Tag="loc:Settings_ServerContains"
                                       VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NewRuleServerPattern"
                                     VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,0,4"
                                     ToolTip="e.g. PROD, DEV, localhost, 192.168.1 (leave empty to match any server)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database name contains:"
                                       Tag="loc:Settings_DatabaseContains"
                                       VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewRuleDatabasePattern"
                                     VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,0,4"
                                     ToolTip="e.g. master, MyDB, _prod (leave empty to match any database)"/>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Status bar and tab color:" Tag="loc:Settings_StatusBarColor" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border x:Name="NewRuleColorPreview" Width="30" Height="22"
                                    Background="#FF4444" BorderBrush="{DynamicResource AxialThemeBorderBrush}" BorderThickness="1"
                                        CornerRadius="2" Margin="0,0,5,0"
                                        Cursor="Hand" MouseLeftButtonUp="NewRuleColorPreview_Click"
                                        ToolTip="Click to pick a color"/>
                                <Button Content="Pick color..." Tag="loc:Settings_PickColor" Click="NewRuleColorPreview_Click" Margin="0,0,15,0"/>
                                <Button Content="+ Add" Tag="loc:Settings_AddRule" Click="ButtonAddColorRule_Click" FontWeight="Bold" Width="60"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Rules list -->
                    <GroupBox Grid.Row="2" Header="Configured rules" Tag="loc:Settings_ConfiguredRules" Padding="5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Content="Edit selected" Tag="loc:Settings_EditSelected" Click="ButtonEditColorRule_Click"
                                        Width="100" Margin="0,0,5,0" FontWeight="Bold"/>
                                <Button Content="Remove selected" Tag="loc:Settings_DeleteSelected" Click="ButtonRemoveColorRule_Click"
                                        Width="120" Margin="0,0,5,0"/>
                            </StackPanel>
                            <ListView x:Name="ConnectionColorRulesListView"
                                      Background="{DynamicResource AxialThemeBackgroundBrush}"
                                      BorderBrush="{DynamicResource AxialThemeBorderBrush}"
                                      Foreground="{DynamicResource AxialThemeForegroundBrush}"
                                      ItemContainerStyle="{StaticResource AxialSettingsListViewItemStyle}"
                                      SelectionMode="Single">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource AxialSettingsGridViewHeaderStyle}">
                                        <GridViewColumn Header="" Width="40">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Server contains" Width="180"
                                                        DisplayMemberBinding="{Binding ServerNamePattern}"/>
                                        <GridViewColumn Header="Database contains" Width="180"
                                                        DisplayMemberBinding="{Binding DatabaseNamePattern}"/>
                                        <GridViewColumn Header="Color" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="50" Height="18" CornerRadius="2"
                                                            Background="{Binding StatusBarColor}"
                                                            BorderBrush="{DynamicResource AxialThemeBorderBrush}" BorderThickness="1"
                                                            Cursor="Hand"
                                                            MouseLeftButtonUp="RuleColorPreview_Click"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </GroupBox>

                    <Button Grid.Row="3"
                            x:Name="button_SaveConnectionColorRules"
                            Click="Button_SaveConnectionColorRules_Click"
                            Width="80"
                            Height="24"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Viewbox Width="16" Height="16" Margin="0,0,4,0">
								<Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
							</Viewbox>
                            <TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabSmtp" Header="SMTP Settings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="WikiSmtpTextBlock"
                               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="10" HorizontalAlignment="left" >
					  <Run Text="Feature description in"/>
					  <Hyperlink
							NavigateUri="https://github.com/liangguopeng1/AxialSqlTools/wiki/Export-Grid-to-Email"
							RequestNavigate="buttonWikiPage_Click">
						<Run Text="Wiki"/>
					  </Hyperlink>
                    </TextBlock>

                    <Label Grid.Row="1" Grid.Column="0" 
						   Content="Sender email address:"
						   Tag="loc:Settings_SenderEmail"
						   Margin="5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"
							 x:Name="MyEmailAddress"
							 Margin="5"/>

                    <Label Grid.Row="2" Grid.Column="0"
						   Content="SMTP user name:"
						   Tag="loc:Settings_SmtpUserName"
						   Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center"
							 x:Name="SMTP_UserName"
							 Margin="5"/>

                    <Label Grid.Row="3" Grid.Column="0"
						   Content="SMTP password:"
						   Tag="loc:Settings_SmtpPassword"
						   Margin="5"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" VerticalContentAlignment="Center"
								 x:Name="SMTP_Password"
								 Margin="5"/>

                    <Label Grid.Row="4" Grid.Column="0"
						   Content="SMTP server:"
						   Tag="loc:Settings_SmtpServer"
						   Margin="5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" VerticalContentAlignment="Center"
							 x:Name="SMTP_Server"
							 Margin="5"/>

                    <Label Grid.Row="5" Grid.Column="0"
						   Content="SMTP port:"
						   Tag="loc:Settings_SmtpPort"
						   Margin="5"/>
                    <TextBox Grid.Row="5" Grid.Column="1" VerticalContentAlignment="Center"
							 x:Name="SMTP_Port"
							 Margin="5"/>

                    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
							  x:Name="SMTP_EnableSSL"
							  Content="Enable SSL/TLS"
							  Tag="loc:Settings_EnableSsl"
							  Margin="5"/>

                    <Button Grid.Row="7" Grid.Column="0"							
							x:Name="buttonSaveSmtpSettings"
							Click="ButtonSaveSmtpSettings_Click"
							Width="80" 
                            Height="24"
							Margin="5"
							HorizontalAlignment="Left"
                            VerticalAlignment="Top"
							FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,4,0">
                                <Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
                            </Viewbox>
                            <TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabUpdates" Header="Updates">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0"
                              x:Name="EnableUpdateChecks"
                              Content="Check for Axial SQL Tools updates on startup"
                              Tag="loc:Settings_CheckUpdatesOnStartup"
                              Margin="5"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                        <Button x:Name="button_SaveUpdateSettings"
                                Click="button_SaveUpdateSettings_Click"
                                Width="80"
                                Height="24"
                                Margin="0,0,10,0"
                                FontWeight="Bold">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16" Margin="0,0,4,0">
                                    <Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
                                </Viewbox>
                                <TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="button_CheckUpdates"
                                Click="button_CheckUpdates_Click"
                                Width="130"
                                Height="24"
                                FontWeight="Bold">
                            <TextBlock Text="Check for updates" Tag="loc:Settings_CheckForUpdates" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <GroupBox Grid.Row="2" Header="Update status" Tag="loc:Settings_UpdateStatus" Margin="5">
                        <TextBlock x:Name="UpdateCheckStatus"
                                   TextWrapping="Wrap"
                                   Margin="5"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="GitHub Integration" Visibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="10" HorizontalAlignment="left" >
		                  <Run Text="Feature description in"/>
		                  <Hyperlink
				                NavigateUri="..."
				                RequestNavigate="buttonWikiPage_Click">
			                <Run Text="Wiki"/>
		                  </Hyperlink>
                    </TextBlock>

                    <Label Grid.Row="1" Grid.Column="0" 
			           Content="GitHub Token:"
			           Margin="5"/>
                    <PasswordBox Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"
							 x:Name="GitHubToken"
							 Margin="5"/>

                    <Button Grid.Row="7" Grid.Column="0"							
				        x:Name="buttonSaveGitHubSettings"
				        Click="buttonSaveGitHubSettings_Click"
				        Width="80" 
                        Height="24"
				        Margin="5"
				        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
				        FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,4,0">
                                <Path Style="{StaticResource AxialSaveIconPathStyle}" Data="{StaticResource SaveIconGeometry}"/>
                            </Viewbox>
                            <TextBlock Text="Save" Tag="loc:Common_Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem Header="OpenAI - ChatGPT integration"
					Visibility="Collapsed">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"
						   Content="API key:"
						   Margin="5"/>
                    <PasswordBox Grid.Row="0" Grid.Column="1"
								 x:Name="OpenAiApiKey"
								 Margin="5"/>

                    <Button Grid.Row="1" Grid.Column="1"
							Content="Save"
							Tag="loc:Common_Save"
							x:Name="button_SaveOpenAi"
							Click="Button_SaveOpenAi_Click"
							Width="60"
							Margin="5"
							HorizontalAlignment="Left"
							FontWeight="Bold"/>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
