<Window x:Class="AxialSqlTools.IntelliSense.CompletionListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Completion"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Width="500"
        MinWidth="500"
        MaxWidth="500"
        Height="220"
        MinHeight="220"
        MaxHeight="320"
        Background="Transparent"
        Focusable="False">
    <Border BorderBrush="#9AA0A6" BorderThickness="1" Background="#FFFFFF" CornerRadius="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ItemsList"
                     Grid.Column="0"
                     Focusable="False"
                     Background="#FFFFFF"
                     Foreground="#1F1F1F"
                     BorderThickness="0"
                     Padding="2,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     SelectionChanged="ItemsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <TextBlock Text="{Binding Glyph}" Width="18" Foreground="#185FA5" VerticalAlignment="Center" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="248"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Background="#FAFAFA">
                <TextBlock x:Name="DetailText"
                           Margin="6,4"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#3C3C3C"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</Window>
