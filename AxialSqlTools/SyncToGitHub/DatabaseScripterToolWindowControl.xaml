<UserControl x:Class="AxialSqlTools.DatabaseScripterToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="600"
             Name="MyToolWindow"
             Background="{DynamicResource AxialThemeBackgroundBrush}"
             Foreground="{DynamicResource AxialThemeForegroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0" Background="{DynamicResource AxialThemeBackgroundBrush}">
        <!-- Frame 1: Main Sync UI -->
        <Grid Name="MainFrame" Visibility="Visible">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0">
                <StackPanel Orientation="Horizontal" Background="{DynamicResource AxialThemeHeaderBackgroundBrush}">
                    <TextBlock Margin="5" HorizontalAlignment="Center" VerticalAlignment="Top"
                               FontWeight="Bold" FontSize="18" Tag="loc:SyncGitHub_HeaderTitle">
                        Sync to GitHub
                    </TextBlock>
                    <TextBlock x:Name="WikiDescriptionTextBlock" Margin="10" HorizontalAlignment="left">
                        <Run Text="Feature description in"/>
				        <Hyperlink
					        NavigateUri="https://github.com/liangguopeng1/AxialSqlTools/wiki/Sync-to-GitHub"
					        RequestNavigate="buttonWikiPage_Click">
				            <Run Text="Wiki"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>



                <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="5">

                    <!-- Profiles -->
                    <GroupBox Margin="0,5" BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}" Tag="loc:SyncGitHub_Profiles">
                        <GroupBox.Header>
                            <TextBlock Text="Profiles" FontSize="14" FontWeight="Bold"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <ComboBox Name="ProfilesComboBox"
                                  Width="300"
                                  ItemsSource="{Binding _profiles}"
                                  DisplayMemberPath="ProfileName"
                                  SelectionChanged="ProfilesComboBox_SelectionChanged"/>
                            <Button Content="+ Add New Profile" Tag="loc:SyncGitHub_AddNewProfile" Width="140" Margin="8,0,0,0"
                                Click="AddNewProfileButton_Click"/>
                            <Button Content="Edit" Tag="loc:Common_Edit" Width="80" Margin="8,0,0,0"
                                Click="EditProfileButton_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Repo Info -->
                    <GroupBox Margin="0,5" BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}" Tag="loc:SyncGitHub_TargetRepoInfo">
                        <GroupBox.Header>
                            <TextBlock Text="Target Repo Info" FontSize="14" FontWeight="Bold"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Vertical" Margin="5">
                            <!-- Repo URL -->
                            <TextBlock Margin="5,2,0,0">
                                <Hyperlink Name="RepoUrlHyperlink" RequestNavigate="RepoUrlHyperlink_RequestNavigate">
                                    Repo: (none selected)
                                </Hyperlink>
                            </TextBlock>

                            <!-- Sync Options -->
                            <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                                <TextBlock Name="RepoSyncOptionsTextBlock"
                                   Text="Sync options will appear here"
                                   Tag="loc:SyncGitHub_SyncOptionsPlaceholder"
                                   FontStyle="Italic"
                                   Opacity="0.72"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                                <TextBlock Name="RepoSyncDbsTextBlock"
                                   Text="List of databases will appear here"
                                   Tag="loc:SyncGitHub_DatabasesPlaceholder"
                                   FontStyle="Italic"
                                   Opacity="0.72"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Commit Section -->
                    <GroupBox Margin="0,5" BorderBrush="{DynamicResource AxialThemeSubtleBorderBrush}" Tag="loc:SyncGitHub_Commit">
                        <GroupBox.Header>
                            <TextBlock Text="Commit" FontSize="14" FontWeight="Bold"/>
                        </GroupBox.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8">
                                <TextBlock Text="Commit Msg:" Tag="loc:SyncGitHub_CommitMsg" Width="80"/>
                                <TextBox Name="MessageTextBox" Width="300"
                                         Background="{DynamicResource AxialThemeBackgroundBrush}"
                                         Foreground="{DynamicResource AxialThemeForegroundBrush}"
                                         BorderBrush="{DynamicResource AxialThemeBorderBrush}"
                                         Text="Add or update scripted objects"/>
                                <CheckBox Name="ConfirmBeforePushing"
                                          Content="Confirm before pushing"
                                          Tag="loc:Common_ConfirmBeforePushing"
                                          Margin="10,0,0,0"/>
                            </StackPanel>
                            <Button Name="RunButton"
                                    Content="Script And Commit"
                                    Tag="loc:Common_ScriptAndCommit"
                                    Width="160" Height="40"
                                    HorizontalAlignment="Left"
                                    Click="RunButton_Click"/>
                            <ProgressBar Name="OverallProgressBar"
                                         Height="16" Minimum="0" Maximum="100"
                                         Background="{DynamicResource AxialThemeButtonBackgroundBrush}"
                                         Foreground="{DynamicResource AxialThemeAccentBrush}"
                                         BorderBrush="{DynamicResource AxialThemeBorderBrush}"
                                         Margin="0,8"/>
                            <ListBox Name="ProgressListBox" Height="200"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Frame 2: Profile Editor -->
        <Grid Name="ProfileEditorFrame" Visibility="Collapsed" Background="{DynamicResource AxialThemeBackgroundBrush}">
            <StackPanel Margin="10">
                <TextBlock Text="Edit Sync Profile" Tag="loc:SyncGitHub_EditProfileTitle" FontWeight="Bold" FontSize="16"/>
                <TextBox Name="ProfileNameTextBox" Margin="0,10,0,0"
                         Background="{DynamicResource AxialThemeBackgroundBrush}"
                         Foreground="{DynamicResource AxialThemeForegroundBrush}"
                         BorderBrush="{DynamicResource AxialThemeBorderBrush}" />

                <TextBlock Text="Repository Details:" Tag="loc:SyncGitHub_RepositoryDetails" Margin="0,10,0,0" FontWeight="SemiBold"/>

                <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Owner:" Tag="loc:SyncGitHub_Owner" Width="80" VerticalAlignment="Center"/>
                        <TextBox Name="RepoOwnerTextBox" Width="250"
                                 Background="{DynamicResource AxialThemeBackgroundBrush}"
                                 Foreground="{DynamicResource AxialThemeForegroundBrush}"
                                 BorderBrush="{DynamicResource AxialThemeBorderBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Repo Name:" Tag="loc:SyncGitHub_RepoName" Width="80" VerticalAlignment="Center"/>
                        <TextBox Name="RepoNameTextBox" Width="250"
                                 Background="{DynamicResource AxialThemeBackgroundBrush}"
                                 Foreground="{DynamicResource AxialThemeForegroundBrush}"
                                 BorderBrush="{DynamicResource AxialThemeBorderBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Branch:" Tag="loc:SyncGitHub_Branch" Width="80" VerticalAlignment="Center"/>
                        <TextBox Name="RepoBranchTextBox" Width="250"
                                 Background="{DynamicResource AxialThemeBackgroundBrush}"
                                 Foreground="{DynamicResource AxialThemeForegroundBrush}"
                                 BorderBrush="{DynamicResource AxialThemeBorderBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Token:" Tag="loc:SyncGitHub_Token" Width="80" VerticalAlignment="Center"/>
                        <PasswordBox Name="RepoTokenBox" Width="250"
                                     Background="{DynamicResource AxialThemeBackgroundBrush}"
                                     Foreground="{DynamicResource AxialThemeForegroundBrush}"
                                     BorderBrush="{DynamicResource AxialThemeBorderBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Content="Set Connection" Tag="loc:SyncGitHub_SetConnection" Click="SetProfileServerConnection_Click"/>
                    <TextBlock Text="Connection Info:" Name="ProfileConnectionInfoTextBox"/>
                </StackPanel>
                
                <CheckBox Name="ExportServerParamsCheckBox" Content="Export SQL Server Configuration Values" Tag="loc:SyncGitHub_ExportServerParams" Margin="0,10,0,0"/>
                <CheckBox Name="ExportJobsCheckBox" Content="Export SQL Server Agent Parameters - Jobs, Operators, Alerts" Tag="loc:SyncGitHub_ExportJobs" Margin="0,10,0,0"/>
                <CheckBox Name="ExportLoginsCheckBox" Content="Export Logins and Permissions" Tag="loc:SyncGitHub_ExportLogins" Margin="0,10,0,0"/>

                <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Databases:" Tag="loc:SyncGitHub_Databases" Width="80" VerticalAlignment="Center"/>
                        <TextBox Name="ListOfDatabasesTextBox" Width="400"
                                 Background="{DynamicResource AxialThemeBackgroundBrush}"
                                 Foreground="{DynamicResource AxialThemeForegroundBrush}"
                                 BorderBrush="{DynamicResource AxialThemeBorderBrush}"/>                        
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Use Ola Hallengren keywords such as ALL_DATABASES, USER_DATABASES, etc." Tag="loc:SyncGitHub_OlaKeywordsHint"/>                       
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="Save Profile" Tag="loc:SyncGitHub_SaveProfile" Click="SaveProfile_Click"/>
                    <Button Content="Cancel" Tag="loc:Common_Cancel" Click="CancelProfileEdit_Click" Margin="10,0,0,0"/>
                    <Button Content="Delete Profile" Tag="loc:SyncGitHub_DeleteProfile" Click="DeleteProfile_Click" Margin="10,0,0,0"
                            Style="{DynamicResource AxialDangerButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
