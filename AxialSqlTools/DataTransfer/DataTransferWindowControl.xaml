                                    <TextBox Grid.Row="1" Grid.Column="1" Height="23" x:Name="TextBox_SourcePsqlPort" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Height="23" x:Name="TextBox_SourcePsqlDatabase" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Height="23" x:Name="TextBox_SourcePsqlUsername" Margin="0,0,8,0" />
                                    <PasswordBox Grid.Row="1" Grid.Column="4" Height="23" x:Name="PasswordBox_SourcePsqlPassword" />
                                    <Button Grid.Row="1" Grid.Column="5" Height="23" Width="70" Margin="8,0,0,0" Content="Saved..." Tag="loc:Common_SavedEllipsis" Click="Button_PickSourcePsql_Click" />
