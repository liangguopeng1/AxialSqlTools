                                    <Label Grid.Row="0" Grid.Column="2" Content="Database" Tag="loc:Common_Database" VerticalAlignment="Center" />
                                    <Label Grid.Row="0" Grid.Column="3" Content="Username" Tag="loc:Common_Username" VerticalAlignment="Center" />
                                    <Label Grid.Row="0" Grid.Column="4" Content="Password" Tag="loc:Common_Password" VerticalAlignment="Center" />

                                    <TextBox Grid.Row="1" Grid.Column="0" Height="23" x:Name="TextBox_TargetMySqlServer" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Height="23" x:Name="TextBox_TargetMySqlPort" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Height="23" x:Name="TextBox_TargetMySqlDatabase" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Height="23" x:Name="TextBox_TargetMySqlUsername" Margin="0,0,8,0" />
                                    <PasswordBox Grid.Row="1" Grid.Column="4" Height="23" x:Name="PasswordBox_TargetMySqlPassword" />
                                    <Button Grid.Row="1" Grid.Column="5" Height="23" Width="70" Margin="8,0,0,0" Content="Saved..." Tag="loc:Common_SavedEllipsis" Click="Button_PickTargetMySql_Click" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Vertical"  Margin="5,5,5,5">
                                <Label Content="Source Query" Tag="loc:Common_SourceQuery" FontWeight="Bold"/>
                                <RichTextBox Height="100" x:Name="RichTextBox_SourceQueryToMySql">
                                    <FlowDocument>
                                        <Paragraph>
                                            <Run Text=""/>
                                        </Paragraph>
                                    </FlowDocument>
                                </RichTextBox>
                            </StackPanel>

                            <StackPanel Orientation="Vertical"  Margin="5,5,5,5">
                                <Label Content="Target Table" Tag="loc:Common_TargetTable" FontWeight="Bold"/>
                                <CheckBox Name="CheckBox_CreateTargetTableToMySql" Content="Create table if it does not exist" Tag="loc:DataTransfer_CreateTableIfNotExists"/>
                                <CheckBox Name="CheckBox_TruncateTargetTableToMySql" Content="Clear target table before inserting new records" Tag="loc:DataTransfer_TruncateTarget"/>
                                <CheckBox Name="CheckBox_SkipDataCopyToMySql" Content="Create table structure only (skip data copying)" Tag="loc:DataTransfer_SkipDataCopy"/>
                                <TextBox Height="23" TextWrapping="Wrap" Text="" x:Name="TextBox_TargetTableToMySql"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal"  Margin="5,5,5,5">
                                <Button Content="Copy Data" Tag="loc:Common_CopyData" Click="ButtonToMySql_CopyData_Click"  Name="ButtonToMySql_CopyData" Margin="5" Width="96" FontWeight="Bold" Style="{DynamicResource AxialPrimaryButtonStyle}" />
                                <Button Content="Cancel" Tag="loc:Common_Cancel" Click="ButtonToMySql_Cancel_Click"  Name="ButtonToMySql_Cancel" Margin="5" Width="76" FontWeight="Bold" Visibility="Collapsed" />
                                <Label Content="(copy progress)" Tag="loc:Common_CopyProgress" x:Name="Label_CopyProgressToMySql" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>

                    </Grid>
                </TabItem>
                <TabItem Header="PostgreSQL -> SQL Server" Tag="loc:DataTransfer_TabPgsqlToSql">
                    <Grid>

                        <StackPanel Orientation="Vertical" >

                            <StackPanel Orientation="Vertical" Margin="5,5,5,5">
                                <Label Content="Source PostgreSQL Connection" Tag="loc:DataTransfer_SourcePgsqlConnection" x:Name="Label_SourceDescriptionFromPsql" FontWeight="Bold"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
