                                <Label Content="(copy progress)" Tag="loc:Common_CopyProgress" x:Name="Label_CopyProgressFromPsql" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>

                    </Grid>
                </TabItem>
                <TabItem Header="MySQL -> SQL Server" Tag="loc:DataTransfer_TabMySqlToSql">
